{
  "name": "mal-map",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Mapa interactivo de constelaciones de anime basado en recomendaciones de MyAnimeList/AniList",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "data:fetch": "node pipeline/fetch-anilist.ts 200",
    "data:fetch-mal": "node pipeline/fetch-mal.ts",
    "data:build": "node pipeline/build.ts",
    "data": "npm run data:fetch && npm run data:fetch-mal && npm run data:build"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "d3-force": "^3.0.1",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-types": "^0.24.8",
    "sigma": "^3.0.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.6.6",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
